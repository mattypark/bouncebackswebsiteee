# PostHog page analytics: one project shared by all of Matthew's sites.
# Project API key from PostHog → Project settings (starts with phc_). It is a
# public, write-only key that ships to the browser. Unset = PostHog stays off.
# Region: "us" (default) or "eu", matching where the PostHog project lives.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_REGION=us
