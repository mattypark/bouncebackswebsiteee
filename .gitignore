# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local media / working files (not part of the app)
/*.png
/*.jpg
/*.jpeg
/*.heic
/*.HEIC
/*.mov
/*.MOV
/*.mp4
/*.MP4
Screenshot*.png
Screen Recording*.mov
ChatGPT Image*

# large video files
public/videos/
public/recycled-reveal.mp4

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# the template ships; real values never do
!.env.example
